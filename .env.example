# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META_OEMBED_TOKEN: Optional Meta App Access Token (AppID|AppSecret)
# Enables rich Instagram oEmbed extraction when self-hosting.
META_OEMBED_TOKEN=""

# JINA_API_KEY: Optional Bearer token for Jina Reader (r.jina.ai) markdown fallback.
# Unauthenticated r.jina.ai requests work free out of the box; a key raises rate limits.
JINA_API_KEY=""

# CACHE_TTL_HOURS: Server-side URL report cache retention in hours (default: 24)
CACHE_TTL_HOURS="24"

# Optional Sponsorship / Ecosystem Redirect Targets (/out/[campaign])
URLMIND_CAMPAIGN_COFFEE=""
URLMIND_CAMPAIGN_AGENTS=""
URLMIND_CAMPAIGN_SUPERINTELLIGENCE=""
URLMIND_CAMPAIGN_STUDY=""
URLMIND_CAMPAIGN_SPONSOR=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token for Repo Intelligence Engine
# Public repositories work without a token; setting this raises GitHub REST API rate limits.
GITHUB_TOKEN=""

# GITHUB_OAUTH_CLIENT_ID & GITHUB_OAUTH_CLIENT_SECRET: Optional GitHub OAuth App
# Enables popup-based read-only OAuth login for user-owned public and private repositories.
# Register callback URL: <APP_URL>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# OAUTH_SESSION_SECRET: Random 32+ char secret for AES-256-GCM encrypted OAuth cookies
OAUTH_SESSION_SECRET=""

# OLLAMA_BASE_URL & OLLAMA_MODEL: Optional local Ollama endpoint for self-hosted open-weights inference
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1:8b"

# AI_PROVIDER: Server-side routing preference (auto | gemini | ollama | deterministic)
AI_PROVIDER="auto"

# Optional Server-Side BYOK Providers (never exposed in client UI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
